# Chinthalli Backend Configuration

# OPTION 1 (Recommended & 100% Free): Google Gemini API (from https://aistudio.google.com)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# OPTION 2: Anthropic Claude API (from console.anthropic.com)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-sonnet-5-5

# OPTION 3: OpenAI API (from platform.openai.com)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# NOTE: If all API keys above are commented out or left blank, Chinthalli automatically runs
# in built-in Smart Standalone Mode! It will handle conversations and actions (Flipkart, Amazon,
# WhatsApp, Calls, Maps, Alarms, YouTube, etc.) with zero setup and zero cost!

# Secret token between backend and Android app (must match local.properties)
APP_TOKEN=chinthalli-secret-token

PORT=8787
